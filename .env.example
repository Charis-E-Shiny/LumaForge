# MongoDB Atlas connection string. Optional: without it the app still works, but runs are
# not logged and the /results page reads results/summary.json.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=lumaforge

# Threads for ONNX Runtime inside the function.
LUMAFORGE_THREADS=2
